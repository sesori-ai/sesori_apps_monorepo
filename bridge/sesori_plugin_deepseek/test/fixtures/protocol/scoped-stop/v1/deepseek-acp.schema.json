{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sesori.ai/protocol/scoped-stop/v1/deepseek-acp.schema.json",
  "title": "DeepSeek scoped stop v1 (additive to extension v2)",
  "$defs": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?=.*\\S).+$"
    },
    "sessionStopRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sessionId"
          ],
          "properties": {
            "kind": {
              "const": "session"
            },
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sessionId",
            "childSessionId"
          ],
          "properties": {
            "kind": {
              "const": "child"
            },
            "sessionId": {
              "$ref": "#/$defs/sessionId"
            },
            "childSessionId": {
              "$ref": "#/$defs/sessionId"
            }
          }
        }
      ]
    },
    "sessionStopResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workKept"
      ],
      "properties": {
        "workKept": {
          "type": "boolean"
        }
      }
    },
    "inputCancelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        }
      }
    },
    "inputCancelResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    }
  }
}
