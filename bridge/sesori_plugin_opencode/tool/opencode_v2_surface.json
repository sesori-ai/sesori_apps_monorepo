{
  "_comment": "Minimum supported OpenCode tag: v2.0.11; models target v2.0.16. This allowlist is the v2 API surface used by the Sesori bridge. Most v2 success responses wrap their payload inline as {data} or {location, data}, so the wrapped payload types are listed in extraSchemas; the v2 Api unwraps them. Request bodies are mostly inline objects and are hand-written like v1's. The v2 event union is opaque in the spec, so events come from tool/opencode_events_v2.json alone and eventManifest is omitted.",
  "specPath": "packages/protocol/openapi.json",
  "hoistSchemas": {
    "Session.Message.Assistant.Content": "Session.Message.Assistant#/properties/content/items",
    "Session.Message.ToolState": "Session.Message.Assistant.Tool#/properties/state"
  },
  "operations": [
    "server.info",
    "location.get",
    "project.list",
    "project.update",
    "session.list",
    "session.create",
    "session.get",
    "session.update",
    "session.remove",
    "session.active",
    "session.message.list",
    "session.prompt",
    "session.command",
    "session.synthetic",
    "session.compact",
    "session.interrupt",
    "session.switchAgent",
    "session.switchModel",
    "permission.request.list",
    "session.permission.reply",
    "form.list",
    "session.form.reply",
    "session.form.cancel",
    "agent.list",
    "model.list",
    "model.default",
    "provider.list",
    "command.list",
    "worktree.remove"
  ],
  "extraSchemas": [
    "Agent.Info",
    "Command.Info",
    "Form.Info",
    "Location.PublicInfo",
    "Location.PublicRef",
    "Model.Info",
    "Permission.Request",
    "Permission.Source",
    "Project",
    "Provider.Info",
    "Session.Inbox.Compaction",
    "Session.Inbox.Synthetic",
    "Session.Inbox.User",
    "Session.Info",
    "Session.StructuredError",
    "SessionActive",
    "TokenUsage.Info",
    "Tool.Content"
  ]
}
